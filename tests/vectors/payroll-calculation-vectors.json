        "pay_period": {"frequency": "monthly", "start": "2026-10-01", "end": "2026-10-31"},
        "earnings": [{"id": "hours", "type": "overtime", "quantity": "1.00001", "unit_rate": "10.00"}],
        "deductions": []
      }
    },
    {
      "id": "duplicate-deduction-id",
      "description": "Reject duplicated deduction identifiers.",
