      "input": {
        "pay_period": {"frequency": "monthly", "start": "2026-10-01", "end": "2026-10-31"},
        "earnings": [{"id": "reversal", "type": "salary", "amount": "-1.00"}],
        "deductions": []
      }
    },
    {
      "id": "quantity-with-too-many-decimals",
