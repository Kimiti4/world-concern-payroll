      "input": {
        "pay_period": {"frequency": "monthly", "start": "2026-10-01", "end": "2026-10-31"},
        "earnings": [{"id": "salary", "type": "salary", "amount": "100.00"}],
        "deductions": [],
        "allocation": {
          "allocation_base": "100.00",
          "allocations": [
            {"cost_centre_id": "CC-A", "basis_points": 6000},
            {"cost_centre_id": "CC-B", "basis_points": 3999}
          ]
        }
